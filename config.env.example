# CharmShark runtime configuration (copy to config.env)
# Read by the launcher; edit values here, then restart the service.

# --- database: SQLite keeps this install self-contained
DATABASE_URL=sqlite:///data/charm-shark.db

# --- secrets (change before deploying)
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_PASSWORD=change-me

# --- local HTTP access: required when served over plain http://
MARLINSPIKE_DEV_INSECURE_COOKIES=true

# --- no Rust DPI binary on Windows -> use the built-in tshark dissector
MARLINSPIKE_DPI_ENGINE=python

# --- optional: declare site networks (comma-separated CIDR)
# Leave empty to use RFC1918 + the observed-topology heuristic.
MARLINSPIKE_SITE_NETWORKS=

# --- beacon candidate settings (candidate filter, not the final verdict)
MARLINSPIKE_BEACON_MIN_INTERVAL=5
MARLINSPIKE_BEACON_MIN_EVENTS=10
MARLINSPIKE_BEACON_MIN_DURATION=300

# --- listener
HOST=127.0.0.1
PORT=5002
